# Local development uses .data/workspace.sqlite automatically.
# Never commit a real database URL or token.
# Vercel requires a PostgreSQL connection string, e.g. Neon pooled connection URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Use a different database for Vercel Preview deployments.
# DATABASE_POOL_MAX=3
PORT=3000
# Real email verification/reset delivery (secure settings only):
# RESEND_API_KEY=
# MAIL_FROM=Room <team@your-verified-domain.com>
# APP_URL=https://your-site.vercel.app
# SUPERADMIN_EMAIL=info@cosmdskin.com
# Codex Cloud only: enable Node native fetch through the inherited HTTPS proxy.
# NODE_USE_ENV_PROXY=1
# Only a deliberately isolated sample should use MAIL_MODE=preview.
